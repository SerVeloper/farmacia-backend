# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=tu usuario
DB_PASSWORD=tu contraeña
DB_NAME=tu base de datos
DB_SYNCHRONIZE=false  # true solo en desarrollo!

# App
APP_PORT=3000
NODE_ENV=development

# Auth JWT
JWT_SECRET=cambiar-esta-clave-en-produccion
REFRESH_TOKEN_SECRET=cambiar-refresh-secret
ACCESS_TOKEN_TTL=15m
SESSION_TTL=24h
REMEMBER_ME_TTL=15d
RESET_TOKEN_TTL_MINUTES=30
AUTH_REFRESH_COOKIE_NAME=farmacia_refresh_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Admin inicial MVP
DEFAULT_ADMIN_EMAIL=admin@farmacia.local
DEFAULT_ADMIN_PASSWORD=admin1234
